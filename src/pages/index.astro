---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import pack from '../data/pack.json';
import PhotoCard from '../components/PhotoCard.astro';
import RhythmBand from '../components/RhythmBand.astro';
import campout from '../assets/photos/campout.png';
import derby from '../assets/photos/derby.jpg';
import rocket from '../assets/photos/rocket.png';
import trail from '../assets/photos/trail.jpg';
import regatta from '../assets/photos/regatta.jpg';
import rocketPrep from '../assets/photos/rocket-prep.webp';
import fishing from '../assets/photos/fishing.webp';
import hammock from '../assets/photos/hammock.webp';
import { Image } from 'astro:assets';
---

<Base
  title="Cub Scout Pack 358 — Lucas, TX"
  description="Cub Scouts for K–5 kids and their families in Lucas, Lovejoy & Allen"
>
  <Hero
    image={campout}
    kicker={`CUB SCOUTS · K–5 · ${pack.area.toUpperCase()}`}
    badge="Boys & girls welcome"
    sub="Campouts, rockets, derby cars, and a pack full of new best friends."
  >
    Less screen time.<br /><span class="gold">More trail time.</span>
    <Fragment slot="cta">
      <a class="btn btn-primary" href="/join">Join Pack 358 →</a>
      <a class="visit-link" href="/our-year#visit">Visit a meeting first</a>
    </Fragment>
  </Hero>

  <section id="what-we-do" class="section">
    <div class="container">
      <div class="section-heading">
        <h2>A year of firsts</h2>
        <div class="rule" aria-hidden="true"></div>
      </div>
      <div class="card-grid">
        <PhotoCard
          image={derby}
          tag="FEBRUARY"
          title="Pinewood Derby"
          blurb="Design it, build it, race it — the most famous event in Scouting."
          position="center 22%"
        />
        <PhotoCard
          image={rocketPrep}
          tag="OCTOBER"
          title="Rocket Launch Day"
          blurb="Build a real model rocket, count it down, watch it fly."
          position="center 38%"
        />
        <PhotoCard
          image={trail}
          tag="DEC & APRIL"
          title="Campouts & Trails"
          blurb="Family campouts and day hikes — parents come too."
          position="center 42%"
        />
        <PhotoCard
          image={fishing}
          tag="MOST CAMPOUTS"
          title="Fishing"
          blurb="First casts, first catches, big stories — whenever camp has a pond."
        />
        <PhotoCard
          image={regatta}
          tag="SEPTEMBER"
          title="Raingutter Regatta"
          blurb="Build a sailboat, race it down the gutter — huff and puff to the finish."
          position="center 35%"
        />
      </div>
      <div class="chip-row">
        <span class="chip">🎖️ Ranks: Lion → Arrow of Light</span>
        <span class="chip">🇺🇸 Service &amp; flag ceremonies</span>
        <span class="chip">🎉 Blue &amp; Gold banquet</span>
      </div>
    </div>
  </section>

  <RhythmBand />

  <section class="section">
    <div class="container why-stay">
      <div class="why-photo">
        <Image src={hammock} alt="Two scouts in Cub Scout t-shirts grinning from a camp hammock" widths={[480, 760]} sizes="(max-width: 720px) 100vw, 380px" />
      </div>
      <div class="why-text">
        <p class="muted">
          Every kid finds their people here — the friends who show up at derby, at
          camp, and at the pack meeting cheering just as loud. You'll find your
          people too, the other parents figuring out badges and forms and
          carpools right alongside you. And because the year runs on a rhythm —
          den meetings, pack meetings, one big adventure each season — you can
          actually plan around it instead of chasing surprises.
        </p>
        <div class="join-cta">
          <a class="btn btn-primary" href="/join">How to Join (2 easy steps) →</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-heading {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .section-heading h2 {
    font-size: 1.4rem;
  }
  .rule {
    height: 3px;
    flex: 1;
    background: linear-gradient(90deg, var(--gold), transparent);
  }
  .card-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 14px;
  }
  .card-grid > :global(*) {
    flex: 0 1 calc((100% - 24px) / 3);
    min-width: 260px;
  }
  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
    justify-content: center;
  }
  .why-stay {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 28px;
    align-items: center;
    max-width: 880px;
  }
  @media (max-width: 720px) {
    .why-stay {
      grid-template-columns: 1fr;
    }
  }
  .why-photo :global(img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(23, 51, 91, 0.15);
  }
  .why-stay p {
    font-size: 0.95rem;
  }
  .join-cta {
    margin-top: 22px;
  }
  .visit-link {
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--gold);
    padding-bottom: 1px;
  }
</style>
