---
import Base from '../layouts/Base.astro';
import StepCard from '../components/StepCard.astro';
import pack from '../data/pack.json';

const zeffyReady = pack.links.zeffyDues !== 'PENDING';
const duesHref = zeffyReady ? pack.links.zeffyDues : '/payments';
---

<Base
  title="Renew for the New Year — Pack 358"
  description="Welcome back! Re-register your scout for the new Pack 358 year — renew BSA membership and pay pack dues in about ten minutes."
>
  <section class="section">
    <div class="container">
      <span class="kicker kicker--dark">WELCOME BACK</span>
      <h1>Re-registering for the new year</h1>
      <p class="intro muted">
        Great to have you back! Same two steps as when you joined — both online, about ten
        minutes total. Your scout moves up to their next den automatically, so this is all
        there is to it.
      </p>

      <div class="step-grid">
        <StepCard n={1} title="Renew your BSA membership">
          Log into <strong>my.scouting.org</strong> — the account you created when your scout
          joined — and renew your scout's membership there. (Renewing adults: same place.)
          <div class="fee-box">
            <strong>${pack.fees.bsa}/year</strong> · paid to Scouting America
          </div>
          <Fragment slot="cta">
            <a class="btn btn-navy" href={pack.links.myScouting} target="_blank" rel="noopener"
              >Renew on my.scouting →</a
            >
          </Fragment>
        </StepCard>

        <StepCard n={2} accent title="Pay this year's pack dues">
          Dues stay right here in the pack — awards &amp; badges, Pinewood Derby kits, Raingutter
          Regatta boats, rockets, the Blue &amp; Gold banquet, and more.
          <div class="fee-box">
            <strong>${pack.fees.pack}/year</strong> · paid to Pack 358
          </div>
          <p class="scholarship">
            Scholarships are available — cost should never keep a kid out of Scouting. Email us,
            no questions asked.
          </p>
          <Fragment slot="cta">
            <a class="btn btn-primary" href={duesHref}>Pay Pack Dues →</a>
            {
              zeffyReady && (
                <p class="tip-pill">
                  💛 At checkout, Zeffy suggests a tip — the tip goes to Zeffy and is optional —
                  feel free to set it to $0.
                </p>
              )
            }
          </Fragment>
        </StepCard>
      </div>

      <div class="notes">
        <p class="muted">
          <strong>New sibling joining this year?</strong> Brand-new scouts register through the
          <a href="/join">Join page</a> instead (and get the free pack t-shirt!).
        </p>
        <p class="muted">
          Questions about dens, dues, or anything else? Email
          <a href={`mailto:${pack.email}`}>{pack.email}</a> — or just ask at the next pack
          meeting.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  h1 {
    margin-top: 4px;
  }
  .intro {
    max-width: 560px;
    margin-top: 10px;
    font-size: 0.95rem;
  }
  .step-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 14px;
    margin-top: 24px;
  }
  .fee-box {
    margin-top: 10px;
    background: var(--cream);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 0.8rem;
    color: var(--navy);
  }
  .scholarship {
    margin-top: 10px;
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .tip-pill {
    display: inline-block;
    margin-top: 10px;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 0.72rem;
    color: var(--ink);
  }
  .notes {
    margin-top: 28px;
    max-width: 640px;
  }
  .notes p {
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .notes p + p {
    margin-top: 10px;
  }
  .notes a {
    color: var(--navy);
  }
</style>
