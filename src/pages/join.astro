---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StepCard from '../components/StepCard.astro';
import FaqList from '../components/FaqList.astro';
import { linkOr } from '../lib/links';
import pack from '../data/pack.json';

const zeffyReady = pack.links.zeffyDues !== 'PENDING';
const duesHref = zeffyReady ? pack.links.zeffyDues : '/payments';
import rocket from '../assets/photos/rocket.png';

const joinNight = 'joinNight' in pack ? pack.joinNight : null;
---

<Base
  title="Join Pack 358 — Cub Scouts in Lucas, Lovejoy & Allen"
  description="Give Cub Scouts a try: visit a Pack 358 meeting, get an invite to our next event, or register today."
>
  <Hero
    image={rocket}
    kicker={`CUB SCOUTS · ${pack.grades} · ${pack.area.toUpperCase()}`}
    badge="Boys & girls welcome"
    sub={`Pack 358 is Cub Scouts for ${pack.grades} kids and their families. Here's how to give it a try — starting with zero commitment.`}
  >
    Camping. Rockets.<br />Derby cars. <span class="gold">Friends.</span>
  </Hero>

  <section class="section">
    <div class="container">
      <div class="ladder">
        <div class="rung rung--primary">
          {
            joinNight ? (
              <>
                <span class="kicker">YOU'RE INVITED — NO SIGN-UP NEEDED</span>
                <h2>{joinNight.title}</h2>
                <p class="event-line">
                  <strong>
                    {joinNight.dateLabel} · {joinNight.time}
                  </strong>
                  <br />
                  {joinNight.place}
                </p>
                <p>
                  A relaxed info session for parents — meet the leaders, hear how the year works,
                  and get every question answered. Kids are absolutely welcome. Register on the
                  spot if you're ready, or just come listen. Nothing to bring, nothing to buy, no
                  commitment.
                </p>
                <div class="event-ctas">
                  <a class="btn btn-primary" href={joinNight.icsFile}>📅 Add to calendar</a>
                  <a
                    class="dir-link"
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(joinNight.mapsQuery)}`}
                    target="_blank"
                    rel="noopener"
                  >
                    Get directions →
                  </a>
                </div>
              </>
            ) : (
              <>
                <span class="kicker">STEP ONE — NO SIGN-UP NEEDED</span>
                <h2>Just come see it</h2>
                <p>
                  Come to any pack meeting — we meet <strong>{pack.packMeeting}</strong>. No
                  registration, no uniform, no commitment. Kids jump straight into the activity,
                  and you can pepper the Cubmaster with questions.
                </p>
                <a class="btn btn-primary" href="/our-year#visit">See when we meet →</a>
              </>
            )
          }
        </div>

        <div class="rung rung--secondary">
          <h3>{joinNight ? `Can't make ${joinNight.dateShort}?` : "Can't make the next one?"}</h3>
          <p class="muted">
            Leave your email and our membership chair will personally invite you to the next event.
            That's all we'll use it for — no newsletter, no spam.
          </p>
          <a class="btn btn-navy" href={linkOr('getInvited', 'Invite us to the next pack event')}
            >Get an invite →</a
          >
        </div>
      </div>

      <div class="explore">
        <span class="kicker kicker--dark">WANT THE FULL PICTURE FIRST?</span>
        <div class="explore-grid">
          <a class="explore-tile" href="/#what-we-do">
            <span class="tile-emoji">🏕️</span>
            <span class="tile-title">What we do</span>
            <span class="tile-blurb">Campouts, derby cars, rockets — a year of firsts</span>
          </a>
          <a class="explore-tile" href="/our-year">
            <span class="tile-emoji">📅</span>
            <span class="tile-title">Our year</span>
            <span class="tile-blurb">When we meet and what each season looks like</span>
          </a>
          <a class="explore-tile" href="/uniforms">
            <span class="tile-emoji">👕</span>
            <span class="tile-title">Uniforms &amp; costs</span>
            <span class="tile-blurb">What to buy, what to skip (Lions: nothing!)</span>
          </a>
          <a class="explore-tile" href="/faq">
            <span class="tile-emoji">💬</span>
            <span class="tile-title">Common questions</span>
            <span class="tile-blurb">Girls? Other districts? Mid-year? All answered</span>
          </a>
        </div>
      </div>

      <div class="ready">
        <span class="kicker kicker--dark">READY TO JOIN NOW?</span>
        <h2>Two steps, two payments</h2>
        <p class="intro muted">
          Registration happens in <strong>two steps with two separate payments</strong> — one to
          Scouting America (national &amp; council), one to the pack. That surprises people, so
          here's exactly how it works and why the money is split that way.
        </p>
      </div>

      <div class="step-grid">
        <StepCard n={1} title="Register with Scouting America">
          This is your child's official BSA membership — insurance, advancement records, the works.
          You'll create an account on <strong>BeAScout</strong>, pick Pack 358, and pay the national
          + council registration fee directly to BSA.
          <div class="fee-box">
            <strong>${pack.fees.bsa}/year</strong> · paid to Scouting America
          </div>
          <Fragment slot="cta">
            <a class="btn btn-navy" href={linkOr('beAScout', 'BeAScout link please')}
              >Register on BeAScout →</a
            >
          </Fragment>
        </StepCard>

        <StepCard n={2} accent title="Pay pack dues">
          Pack dues stay right here in the pack — they fund awards &amp; badges, Pinewood Derby
          kits, Raingutter Regatta boats, rockets, the Blue &amp; Gold banquet, and more. New
          scouts also get a free pack t-shirt (your Class B uniform). Paid online through our
          secure payment page, card or bank transfer, and 100% goes to the pack.
          <div class="fee-box">
            <strong>${pack.fees.pack}/year</strong> · paid to Pack 358
          </div>
          <p class="scholarship">
            Scholarships are available — cost should never keep a kid out of Scouting. Email us, no
            questions asked.
          </p>
          <Fragment slot="cta">
            <a class="btn btn-primary" href={duesHref}>Pay Pack Dues →</a>
            {
              zeffyReady && (
                <p class="tip-pill">
                  💛 At checkout, Zeffy suggests a tip — the tip goes to Zeffy and is optional —
                  feel free to set it to $0.
                </p>
              )
            }
          </Fragment>
        </StepCard>
      </div>

      <p class="cost-summary muted">
        <strong>What it costs, all-in:</strong> BSA registration (${pack.fees.bsa}) + pack dues (${
          pack.fees.pack
        }) + uniform (~${pack.fees.uniformLow}–${pack.fees.uniformHigh}, see our
        <a href="/uniforms">gear guide</a> for what to skip) — and remember: scholarships are
        available.
      </p>

      <div class="faq-strip">
        <h2>Common questions</h2>
        <FaqList />
      </div>
    </div>
  </section>
</Base>

<style>
  .ladder {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 14px;
  }
  @media (max-width: 720px) {
    .ladder {
      grid-template-columns: 1fr;
    }
  }
  .rung--primary {
    background: var(--navy);
    border-radius: 12px;
    padding: 26px 28px;
    color: #dce4ef;
  }
  .rung--primary h2 {
    color: #fff;
    margin: 6px 0 10px;
  }
  .rung--primary p {
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .rung--secondary {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .rung--secondary h3 {
    font-size: 1.05rem;
  }
  .event-line {
    margin: 12px 0;
    font-size: 1.15rem;
    line-height: 1.4;
    color: var(--gold);
  }
  .event-line strong {
    color: #fff;
    font-size: 1.25rem;
  }
  .event-ctas {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 4px;
  }
  .dir-link {
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--gold);
    padding-bottom: 1px;
  }
  .explore {
    margin-top: 28px;
  }
  .explore-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 10px;
    margin-top: 12px;
  }
  .explore-tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }
  .explore-tile:hover {
    box-shadow: 0 2px 8px rgba(23, 51, 91, 0.15);
  }
  .tile-emoji {
    font-size: 1.2rem;
  }
  .tile-title {
    font-weight: 800;
    color: var(--navy);
    font-size: 0.9rem;
  }
  .tile-blurb {
    font-size: 0.75rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .rung--secondary p {
    font-size: 0.85rem;
    line-height: 1.55;
    flex: 1;
  }
  .ready {
    margin-top: 44px;
  }
  .ready h2 {
    margin-top: 4px;
  }
  .intro {
    max-width: 560px;
    margin-top: 10px;
    font-size: 0.95rem;
  }
  .step-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 14px;
    margin-top: 24px;
  }
  .fee-box {
    margin-top: 10px;
    background: var(--cream);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 0.8rem;
    color: var(--navy);
  }
  .scholarship {
    margin-top: 10px;
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .tip-pill {
    display: inline-block;
    margin-top: 10px;
    background: var(--cream);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 0.72rem;
    color: var(--ink);
  }
  .cost-summary {
    margin-top: 18px;
    font-size: 0.8rem;
    line-height: 1.6;
    max-width: 640px;
  }
  .cost-summary a {
    text-decoration: underline;
  }
  .faq-strip {
    margin-top: 40px;
  }
  .faq-strip h2 {
    font-size: 1.2rem;
  }
</style>
