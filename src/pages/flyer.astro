---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PatchLogo from '../components/PatchLogo.astro';
import rocket from '../assets/photos/rocket.png';
import pack from '../data/pack.json';
---

<Base title="Join Pack 358 — Print Flyer" description="Cub Scout Pack 358 recruiting flyer" noindex bare>
  <div class="sheet">
    <div class="photo-band">
      <Image src={rocket} alt="" width={850} height={520} loading="eager" />
      <div class="photo-tint"></div>
      <div class="photo-caption">
        <div class="brand-row">
          <PatchLogo size={30} />
          <span class="brand-name">LOVEJOY PACK 358 &middot; CUB SCOUTS</span>
        </div>
        <h1 class="headline">Camping. Rockets.<br />Derby cars. <span class="gold">Friends.</span></h1>
      </div>
    </div>

    <div class="middle">
      <p class="pitch">
        Cub Scouts is for <strong>all kids, K&ndash;5th grade</strong> &mdash; and their
        families. One den meeting and one pack meeting a month, and
        a big adventure every season.
      </p>

      <div class="chip-row">
        <div class="chip"><div class="chip-emoji">&#9970;</div><div class="chip-label">FAMILY CAMPOUTS</div></div>
        <div class="chip"><div class="chip-emoji">&#127950;&#65039;</div><div class="chip-label">PINEWOOD DERBY</div></div>
        <div class="chip"><div class="chip-emoji">&#128640;</div><div class="chip-label">ROCKET LAUNCHES</div></div>
        <div class="chip"><div class="chip-emoji">&#9973;</div><div class="chip-label">REGATTA RACES</div></div>
      </div>

      <div class="join-card">
        <div class="join-kicker">HOW TO JOIN &mdash; 2 STEPS</div>
        <div class="join-steps">
          <div class="join-step">
            <b>1 &middot; Register with Scouting America</b><br />
            10 min on BeAScout &mdash; national membership (${pack.fees.bsa}).
          </div>
          <div class="join-step">
            <b>2 &middot; Pay pack dues online</b><br />
            Funds badges, derby kits &amp; campouts (${pack.fees.pack}).
          </div>
        </div>
        <div class="join-footnote">Scholarships available &mdash; cost should never keep a kid out of Scouting.</div>
      </div>
    </div>

    <div class="bottom-bar">
      <img src="/qr-join.svg" alt="QR code to lovejoypack358.com/join" class="qr" width="106" height="106" />
      <div class="bottom-text">
        <div class="url">lovejoypack358.com/join</div>
        <div class="blurb">
          Scan to see everything we do, what it costs, and when we meet &mdash;
          or just come visit a pack meeting!
        </div>
        <div class="email">Questions? {pack.email}</div>
      </div>
    </div>
  </div>
</Base>

<style is:global>
  @page {
    size: letter;
    margin: 0;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    background: #fff;
  }
</style>

<style>
  .sheet {
    width: 8.5in;
    height: 11in;
    display: flex;
    flex-direction: column;
    background: #fff;
    font-family: var(--font);
    overflow: hidden;
  }

  .photo-band {
    position: relative;
    flex: 0 0 3.4in;
    overflow: hidden;
  }
  .photo-band :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(15, 32, 58, 0.25) 0%, rgba(15, 32, 58, 0.85) 100%);
  }
  .photo-caption {
    position: absolute;
    left: 0.35in;
    right: 0.35in;
    bottom: 0.3in;
  }
  .brand-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand-name {
    color: var(--gold);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
  }
  .headline {
    margin-top: 10px;
    font-size: 34px;
    font-weight: 900;
    color: #fff;
    line-height: 1.08;
  }
  .headline .gold {
    color: var(--gold);
  }

  .middle {
    flex: 1;
    padding: 0.35in 0.4in;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4in;
  }
  .pitch {
    font-size: 17px;
    color: var(--ink);
    line-height: 1.55;
  }
  .chip-row {
    display: flex;
    gap: 14px;
  }
  .chip {
    flex: 1;
    background: var(--cream);
    border-radius: 12px;
    padding: 0.22in 8px;
    text-align: center;
  }
  .chip-emoji {
    font-size: 28px;
  }
  .chip-label {
    margin-top: 8px;
    font-size: 12px;
    font-weight: 800;
    color: var(--navy);
    letter-spacing: 0.5px;
  }

  .join-card {
    background: var(--navy);
    border-radius: 14px;
    padding: 0.3in 0.32in;
  }
  .join-kicker {
    font-size: 14px;
    font-weight: 800;
    color: var(--gold);
    letter-spacing: 2px;
  }
  .join-steps {
    display: flex;
    gap: 20px;
    margin-top: 14px;
  }
  .join-step {
    flex: 1;
    font-size: 14px;
    color: #dce4ef;
    line-height: 1.55;
  }
  .join-step b {
    color: #fff;
  }
  .join-footnote {
    margin-top: 14px;
    font-size: 13px;
    color: #8fa3bf;
  }

  .bottom-bar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.2in;
    padding: 0.22in 0.35in;
    background: var(--cream);
    border-top: 3px solid var(--gold);
  }
  .qr {
    width: 1.1in;
    height: 1.1in;
    background: #fff;
    border: 4px solid #fff;
    border-radius: 4px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
  }
  .url {
    font-size: 18px;
    font-weight: 900;
    color: var(--navy);
  }
  .blurb {
    margin-top: 4px;
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .email {
    margin-top: 4px;
    font-size: 12px;
    font-weight: 700;
    color: var(--orange);
  }
</style>
