---
import { Image } from 'astro:assets';
import logo from '../assets/cub-scouts-logo.png';

const { size = 40 } = Astro.props;
---

<Image
  src={logo}
  alt="Cub Scouts"
  width={size * 2}
  height={size * 2}
  class="patch-logo"
  style={`width:${size}px;height:${size}px;`}
/>
<style>
  .patch-logo {
    display: inline-block;
    object-fit: contain;
  }
</style>
