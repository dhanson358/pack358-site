---
const { size = 40 } = Astro.props;
---
<span class="patch" style={`width:${size}px;height:${size}px;font-size:${size * 0.38}px;`}>358</span>
<style>
  .patch { display: inline-flex; align-items: center; justify-content: center; border-radius: 50%;
    background: var(--gold); border: 2px solid var(--cream); color: var(--navy); font-weight: 900; }
</style>
