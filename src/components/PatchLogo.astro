---
const { size = 40 } = Astro.props;
---

<span class="patch" style={`width:${size}px;height:${size}px;`}>
  <span class="fleur" style={`font-size:${size * 0.34}px;`} aria-hidden="true">⚜</span>
  <span class="num" style={`font-size:${size * 0.32}px;`}>358</span>
</span>
<style>
  .patch {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--gold);
    border: 2px solid var(--cream);
    color: var(--navy);
    font-weight: 900;
  }
  .fleur {
    line-height: 1;
    margin-bottom: -1px;
  }
  .num {
    line-height: 1;
  }
</style>
