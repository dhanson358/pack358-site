---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  tag: string;
  title: string;
  blurb: string;
  /** CSS object-position for the crop window, e.g. "center 35%" (default centers) */
  position?: string;
}

const { image, tag, title, blurb, position = '50% 50%' } = Astro.props;
---

<div class="card photo-card">
  <div class="photo-wrap">
    <Image src={image} alt="" widths={[320, 480, 640]} sizes="(min-width: 640px) 480px, 100vw" class="photo" style={`object-position: ${position};`} />
    <span class="tag">{tag}</span>
  </div>
  <div class="body">
    <div class="title">{title}</div>
    <div class="blurb">{blurb}</div>
  </div>
</div>

<style>
  .photo-wrap {
    position: relative;
  }
  .photo {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16/8.5;
    object-fit: cover;
  }
  .tag {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--navy);
    color: var(--gold);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .body {
    padding: 10px 12px;
  }
  .title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--navy);
  }
  .blurb {
    font-size: 0.75rem;
    color: var(--ink-soft);
    margin-top: 2px;
  }
</style>
